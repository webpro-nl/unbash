{
  "hooks": {
    "before:init": ["pnpm build", "pnpm lint", "pnpm test"]
  },
  "npm": {
    "stage": true
  },
  "github": {
    "release": true,
    "releaseNotes": {
      "commit": "* ${commit.subject} (${sha}){ - thanks @${author.login}!}",
      "excludeMatches": ["webpro"]
    },
    "comments": {
      "submit": true
    }
  }
}
